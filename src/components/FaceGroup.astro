---
/**
 * One texture set of a block: its PBR maps, the varieties that can replace it,
 * and its resolution control.
 *
 * A block that uses the same texture on every face renders one of these; a log
 * renders two. Grouping this way is what lets per-face textures live under a
 * single block slug.
 */
import TextureTile from "./TextureTile.astro";
import { resizeOptionsFor } from "../lib/resize";
import type { IFaceGroup } from "../lib/catalog";
import type { ITextureSet, IVariety, TextureRole } from "../lib/types";

interface Props {
  /** The faces sharing this texture set. */
  group: IFaceGroup;
  /** The texture set itself. */
  set: ITextureSet | undefined;
  /** Varieties that can replace it. */
  varieties: IVariety[];
}

const { group, set, varieties } = Astro.props;

/** PBR maps to show alongside the colour map, in a fixed order. */
const ROLES: readonly { role: TextureRole; label: string }[] = [
  { role: "color", label: "Color" },
  { role: "mer", label: "MER" },
  { role: "mers", label: "MERS" },
  { role: "normal", label: "Normal" },
  { role: "heightmap", label: "Height" },
];

const present = set
  ? ROLES.filter((entry) => set[entry.role] !== undefined)
  : [];

const shortName = group.setId.replace("textures/blocks/", "");
const options = set ? resizeOptionsFor(set.color.width) : [];
const nativeWidth = set?.color.width ?? 0;
---

<section class="face-group card">
  <header class="face-group__head">
    <h3>{group.label}</h3>
    <code class="muted">{shortName}</code>
    {set?.flipbook && (
      <span class="tag">{set.flipbook.frames} frames · {set.flipbook.ticksPerFrame}t</span>
    )}
    {set?.origin === "vanilla" && <span class="tag">vanilla</span>}
  </header>

  {set ? (
    <>
      <div class="face-group__maps">
        {present.map((entry) => {
          const texture = set[entry.role];

          return texture ? (
            <figure>
              <TextureTile
                texture={texture}
                origin={set.origin}
                flipbook={set.flipbook}
                label={`${shortName} ${entry.label}`}
              />
              <figcaption>
                {entry.label}
                <span class="muted">
                  {texture.width > 0 ? ` ${texture.width}×${texture.height}` : ""}
                  {texture.ext === "tga" ? " · TGA" : ""}
                </span>
              </figcaption>
            </figure>
          ) : null;
        })}
      </div>

      <div class="face-group__controls">
        <jg-resize-control set-id={group.setId}>
          <label>
            Resolution
            <select>
              <option value="">
                {nativeWidth > 0 ? `Native (${nativeWidth}px)` : "Native"}
              </option>
              {options.map((size) => <option value={size}>{size}px</option>)}
            </select>
          </label>
        </jg-resize-control>
        {options.length === 0 && (
          <span class="muted note">Already at the smallest offered size.</span>
        )}
      </div>

      {varieties.length > 0 && (
        <jg-variety-picker set-id={group.setId}>
          <fieldset class="face-group__varieties">
            <legend>Variety</legend>
            <label class="variety">
              <input type="radio" name={`variety:${group.setId}`} value="" checked />
              <span class="variety__swatch variety__swatch--default" aria-hidden="true"></span>
              <span>Pack default</span>
            </label>
            {varieties.map((variety) => (
              <label class="variety">
                <input type="radio" name={`variety:${group.setId}`} value={variety.id} />
                <span class="variety__swatch">
                  <TextureTile
                    texture={variety.color}
                    flipbook={undefined}
                    label={`${variety.label} variety`}
                  />
                </span>
                <span>{variety.label}</span>
              </label>
            ))}
          </fieldset>
        </jg-variety-picker>
      )}
    </>
  ) : (
    <p class="muted">This texture could not be resolved in the catalog.</p>
  )}
</section>

<style>
  .face-group {
    margin-block-end: var(--gap);
  }

  .face-group__head {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
  }

  .face-group__head h3 {
    font-size: 1rem;
    margin: 0;
  }

  .face-group__maps {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
  }

  .face-group__maps figure {
    margin: 0;
  }

  .face-group__maps figcaption {
    font-size: 0.75rem;
    margin-block-start: 0.25rem;
  }

  .face-group__controls {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.875rem;
  }

  .face-group__controls label {
    align-items: center;
    display: flex;
    font-size: 0.875rem;
    gap: 0.5rem;
  }

  .note {
    font-size: 0.8125rem;
  }

  .face-group__varieties {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.875rem;
  }

  .face-group__varieties legend {
    font-size: 0.8125rem;
    padding-inline: 0.375rem;
  }

  .variety {
    align-items: center;
    display: flex;
    font-size: 0.8125rem;
    gap: 0.375rem;
  }

  .variety__swatch {
    display: block;
    inline-size: 2.5rem;
  }

  .variety__swatch--default {
    aspect-ratio: 1;
    background-color: light-dark(#dcdce2, #26262c);
    border-radius: 0.25rem;
  }
</style>

<script>
  import "../elements/jg-resize-control";
  import "../elements/jg-variety-picker";
</script>
