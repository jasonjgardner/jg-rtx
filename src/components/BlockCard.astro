---
/**
 * A block's entry in the index grid: its first face texture plus a coverage tag.
 */
import TextureTile from "./TextureTile.astro";
import type { IBlockEntry, ITextureSet } from "../lib/types";

interface Props {
  block: IBlockEntry;
  /** The texture set for the block's first resolved face. */
  set: ITextureSet | undefined;
  /** Site-base-aware href for the block page. */
  href: string;
}

const { block, set, href } = Astro.props;
---

<a class="card block-card" href={href} data-name={block.name.toLowerCase()} data-coverage={block.coverage}>
  {set
    ? <TextureTile texture={set.color} origin={set.origin} flipbook={set.flipbook} label={`${block.name} preview`} />
    : <div class="block-card__missing" aria-hidden="true"></div>}
  <span class="block-card__name">{block.name}</span>
  {block.uniform ? null : <span class="tag">{block.sets.length} faces</span>}
  {block.coverage === "vanilla" ? <span class="tag block-card__vanilla">vanilla</span> : null}
</a>

<style>
  .block-card {
    color: inherit;
    display: grid;
    gap: 0.375rem;
    justify-items: start;
    text-decoration: none;
  }

  .block-card:hover {
    border-color: var(--accent);
  }

  .block-card__name {
    font-size: 0.8125rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .block-card__missing {
    aspect-ratio: 1;
    background-color: light-dark(#e8e8e8, #1b1b1b);
    border-radius: 0.25rem;
    inline-size: 100%;
  }

  .block-card__vanilla {
    background-color: color-mix(in oklab, var(--muted) 20%, transparent);
    color: var(--muted);
  }
</style>
